<Project>
  <PropertyGroup>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <EvolveGameName>Evolve</EvolveGameName>
    <EvolveDisplayVersion>v0.001</EvolveDisplayVersion>
    <EvolveGeneratorVersion>landmass-6</EvolveGeneratorVersion>
    <EvolveSaveFormatVersion>2</EvolveSaveFormatVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EvolveGameName</_Parameter1>
      <_Parameter2>$(EvolveGameName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EvolveDisplayVersion</_Parameter1>
      <_Parameter2>$(EvolveDisplayVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EvolveGeneratorVersion</_Parameter1>
      <_Parameter2>$(EvolveGeneratorVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EvolveSaveFormatVersion</_Parameter1>
      <_Parameter2>$(EvolveSaveFormatVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
